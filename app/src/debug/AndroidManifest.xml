<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only overlay: makes the survey components reachable from `adb am start` /
  `am broadcast` so the nightly survey can be triggered on demand during testing
  without waiting for the 8pm alarm. NOT part of release builds — production keeps
  android:exported="false" from the main manifest.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity
            android:name=".SurveyActivity"
            android:exported="true"
            tools:replace="android:exported" />
        <receiver
            android:name=".SurveyAlarmReceiver"
            android:exported="true"
            tools:replace="android:exported" />
    </application>
</manifest>
